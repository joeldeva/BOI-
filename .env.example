# Local development profile. Production values belong in the bank secret/config
# platform and are documented below; never commit a populated .env.
FRAUDSHIELD_ENV=development
FRAUDSHIELD_DEBUG=false
FRAUDSHIELD_DATA_DIR=./runtime

# Development database/artifacts
FRAUDSHIELD_DATABASE_PATH=./runtime/fraudshield.db
FRAUDSHIELD_STORAGE_BACKEND=local

# Browser-compatible, loopback-only local profile. Production validation forbids
# disabled authentication. To test API-key mode, use a non-browser API client.
FRAUDSHIELD_AUTH_MODE=disabled
FRAUDSHIELD_API_KEY=
FRAUDSHIELD_TRUSTED_HOSTS=localhost,127.0.0.1,testserver
FRAUDSHIELD_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRAUDSHIELD_FORWARDED_ALLOW_IPS=127.0.0.1

# Local feature switches
FRAUDSHIELD_DOCS_ENABLED=true
FRAUDSHIELD_DEMO_ENABLED=true
FRAUDSHIELD_LEGACY_API_ENABLED=true
FRAUDSHIELD_INLINE_ANALYSIS_ENABLED=true
FRAUDSHIELD_METRICS_ENABLED=false

# Upload/archive/queue limits
FRAUDSHIELD_MAX_APK_BYTES=78643200
FRAUDSHIELD_MAX_ZIP_ENTRIES=20000
FRAUDSHIELD_MAX_ZIP_UNCOMPRESSED_BYTES=524288000
FRAUDSHIELD_MAX_CONCURRENT_APK_ANALYSES=2
FRAUDSHIELD_JOB_LEASE_SECONDS=1800
FRAUDSHIELD_WORKER_POLL_SECONDS=2
FRAUDSHIELD_RETAIN_UPLOADS=false

# Local multi-engine controls. Engines that are enabled but not installed are
# reported as unavailable; that state is never treated as a clean verdict.
FRAUDSHIELD_ENGINE_TIMEOUT_SECONDS=120
FRAUDSHIELD_MAX_ENGINE_OUTPUT_BYTES=2097152
FRAUDSHIELD_APKID_ENABLED=true
FRAUDSHIELD_YARA_ENABLED=true
FRAUDSHIELD_YARA_RULES_PATH=./fraudshield/resources/yara/deceptiscope_banking.yar
FRAUDSHIELD_SIGNATURE_VERIFICATION_ENABLED=true
FRAUDSHIELD_APKSIGNER_PATH=apksigner
FRAUDSHIELD_SIMILARITY_ENABLED=true
FRAUDSHIELD_QUARK_ENABLED=false
FRAUDSHIELD_QUARK_RULES_DIR=./runtime/quark-rules
FRAUDSHIELD_QUARK_MAX_RULES=300

# Optional self-hosted MobSF. This sends the APK to the configured private
# service and therefore requires a separate explicit transfer flag.
FRAUDSHIELD_MOBSF_ENABLED=false
FRAUDSHIELD_MOBSF_URL=
FRAUDSHIELD_MOBSF_API_KEY=
FRAUDSHIELD_MOBSF_ALLOW_BINARY_TRANSFER=false

# Optional public hash-only reputation. The APK bytes are never submitted.
# "not found" and zero detections are never interpreted as safe.
FRAUDSHIELD_REPUTATION_ENABLED=false
FRAUDSHIELD_ALLOW_EXTERNAL_REPUTATION_IN_PRODUCTION=false
FRAUDSHIELD_EXTERNAL_LOOKUP_TIMEOUT_SECONDS=20
FRAUDSHIELD_VIRUSTOTAL_API_KEY=
FRAUDSHIELD_VIRUSTOTAL_MALICIOUS_THRESHOLD=5
FRAUDSHIELD_MALWAREBAZAAR_API_KEY=

# Audit integrity. Production requires a random 32+ character secret from the
# bank secrets manager. Prior keys use comma-separated key-id=secret entries.
FRAUDSHIELD_AUDIT_HMAC_KEY=
FRAUDSHIELD_AUDIT_HMAC_KEY_ID=v1
FRAUDSHIELD_AUDIT_HMAC_PREVIOUS_KEYS=
FRAUDSHIELD_AUDIT_RETENTION_DAYS=180

# Official bank Android signing-certificate SHA-256 fingerprints.
FRAUDSHIELD_TRUSTED_BANK_CERT_SHA256=

# Optional narrative layer; risk scores remain deterministic.
FRAUDSHIELD_LLM_PROVIDER=disabled
FRAUDSHIELD_LLM_API_KEY=
FRAUDSHIELD_LLM_MODEL=
FRAUDSHIELD_LLM_TIMEOUT_SECONDS=20

# Emulator-only dynamic-lite. Keep disabled in the production reference.
FRAUDSHIELD_DYNAMIC_ANALYSIS_ENABLED=false
FRAUDSHIELD_ADB_PATH=adb
FRAUDSHIELD_ADB_EMULATOR_SERIAL=
FRAUDSHIELD_DYNAMIC_TIMEOUT_SECONDS=90

# Production-only examples (configure through Helm/secrets, not this file):
# FRAUDSHIELD_ENV=production
# FRAUDSHIELD_DATABASE_URL=postgresql://user:secret@db.bank.example/fraudshield?sslmode=verify-full&sslrootcert=/etc/fraudshield/ca/ca-bundle.crt
# FRAUDSHIELD_DATABASE_POOL_MIN_SIZE=2
# FRAUDSHIELD_DATABASE_POOL_MAX_SIZE=20
# FRAUDSHIELD_STORAGE_BACKEND=s3
# FRAUDSHIELD_S3_BUCKET=bank-fraudshield-evidence
# FRAUDSHIELD_S3_PREFIX=fraudshield
# FRAUDSHIELD_S3_REGION=ap-south-1
# FRAUDSHIELD_S3_ENDPOINT_URL=https://objectstore.bank.example
# FRAUDSHIELD_S3_KMS_KEY_ID=alias/fraudshield-evidence
# FRAUDSHIELD_AUTH_MODE=oidc
# FRAUDSHIELD_OIDC_ISSUER=https://identity.bank.example/realms/workforce
# FRAUDSHIELD_OIDC_AUDIENCE=fraudshield-api
# FRAUDSHIELD_OIDC_JWKS_URL=https://identity.bank.example/realms/workforce/protocol/openid-connect/certs
# FRAUDSHIELD_OIDC_ALGORITHMS=RS256
# FRAUDSHIELD_OIDC_ROLES_CLAIM=roles
# FRAUDSHIELD_DOCS_ENABLED=false
# FRAUDSHIELD_DEMO_ENABLED=false
# FRAUDSHIELD_LEGACY_API_ENABLED=false
# FRAUDSHIELD_INLINE_ANALYSIS_ENABLED=false
# FRAUDSHIELD_METRICS_ENABLED=true
