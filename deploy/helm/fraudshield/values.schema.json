{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["image", "existingSecret", "config", "api", "worker", "frontend"],
  "properties": {
    "existingSecret": {"type": "string", "minLength": 1},
    "image": {
      "type": "object",
      "required": ["repository"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string"},
        "digest": {"type": "string"}
      }
    },
    "frontend": {
      "type": "object",
      "required": ["enabled", "image", "replicaCount"],
      "properties": {
        "enabled": {"type": "boolean"},
        "replicaCount": {"type": "integer", "minimum": 2},
        "image": {
          "type": "object",
          "required": ["repository"],
          "properties": {
            "repository": {"type": "string", "minLength": 1},
            "tag": {"type": "string"},
            "digest": {"type": "string"}
          }
        }
      }
    },
    "config": {
      "type": "object",
      "required": ["trustedHosts", "corsOrigins", "oidc", "storage", "analysis"],
      "properties": {
        "trustedHosts": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "corsOrigins": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^https://"}},
        "oidc": {
          "type": "object",
          "required": ["issuer", "audience", "jwksUrl"],
          "properties": {
            "issuer": {"type": "string", "pattern": "^https://"},
            "audience": {"type": "string", "minLength": 1},
            "jwksUrl": {"type": "string", "pattern": "^https://"}
          }
        },
        "storage": {
          "type": "object",
          "required": ["bucket", "kmsKeyId"],
          "properties": {
            "bucket": {"type": "string", "minLength": 1},
            "kmsKeyId": {"type": "string", "minLength": 1}
          }
        },
        "analysis": {
          "type": "object",
          "required": [
            "apkidEnabled",
            "yaraEnabled",
            "signatureVerificationEnabled",
            "similarityEnabled",
            "quarkEnabled",
            "mobsfEnabled",
            "mobsfAllowBinaryTransfer",
            "reputationEnabled",
            "allowExternalReputationInProduction"
          ],
          "properties": {
            "apkidEnabled": {"type": "boolean"},
            "yaraEnabled": {"type": "boolean"},
            "signatureVerificationEnabled": {"type": "boolean"},
            "similarityEnabled": {"type": "boolean"},
            "quarkEnabled": {"type": "boolean"},
            "quarkMaxRules": {"type": "integer", "minimum": 1, "maximum": 10000},
            "engineTimeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 3600},
            "maxEngineOutputBytes": {"type": "integer", "minimum": 1024},
            "mobsfEnabled": {"type": "boolean"},
            "mobsfUrl": {"type": "string"},
            "mobsfAllowBinaryTransfer": {"type": "boolean"},
            "reputationEnabled": {"type": "boolean"},
            "allowExternalReputationInProduction": {"type": "boolean"},
            "externalLookupTimeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 300},
            "virustotalMaliciousThreshold": {"type": "integer", "minimum": 1}
          }
        }
      }
    }
  }
}
